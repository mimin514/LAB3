void handle_mode(uint8_t mode) {
    switch (mode) {
        case 1:
            // Chế độ bình thường - Chạy đèn giao thông
            break;
        case 2:
            // Chế độ sửa đổi thời gian đèn đỏ
            modify_red_duration();
            break;
        case 3:
            // Chế độ sửa đổi thời gian đèn vàng
            modify_amber_duration();
            break;
        case 4:
            // Chế độ sửa đổi thời gian đèn xanh
            modify_green_duration();
            break;
    }
}
